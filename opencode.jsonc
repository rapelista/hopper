{
  "$schema": "https://opencode.ai/config.json",
  // Hopper permission preset: default-deny posture.
  // Active tooling lives in agent-specific permission overrides (see .opencode/agents/).
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "grep *": "allow",
      "ls *": "allow"
    },
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "plugins": []
}
