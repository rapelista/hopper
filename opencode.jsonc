{
  "$schema": "https://opencode.ai/config.json",
  // Hopper permission preset: default-deny posture.
  // Personas, commands, skills, tools, and the kernel plugin all travel with the
  // plugin package in src/ (registered via "plugins" below and by the global
  // config); agent-specific permission overrides ship inside the personas.
  "plugins": ["."],
  "permission": {
    "bash": {
      "*": "ask",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "grep *": "allow",
      "ls *": "allow"
    },
    "edit": "ask",
    "webfetch": "ask",
    "external_directory": "ask",
    "doom_loop": "ask"
  },
  "plugins": []
}
